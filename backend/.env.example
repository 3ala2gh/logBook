DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Free key from https://openrouteservice.org/dev/#/signup (routing + reverse geocoding).
# Without it the app falls back to the public OSRM demo server and Nominatim.
ORS_API_KEY=

# Identify the app to Nominatim/Photon as their usage policies require.
GEOCODER_USER_AGENT=eld-trip-planner/1.0 (you@example.com)
